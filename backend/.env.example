# GeoMine AI Backend Environment Configuration

# Database Connection (Neon PostgreSQL or Local PostgreSQL)
# For Neon, copy your connection string from the Neon dashboard (with sslmode=require)
DATABASE_URL=postgresql://username:password@ep-your-neon-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# Fallback SQLite database for local offline development (if PostgreSQL is not yet configured)
# SQLITE_URL=sqlite:///./geomine_dev.db

# JWT Authentication Secret & Algorithm
SECRET_KEY=geomine_super_secret_jwt_key_2026_replace_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Environment
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
PORT=8000

